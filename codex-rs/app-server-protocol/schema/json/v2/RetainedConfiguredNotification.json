{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "RetainedFrontierFailure": {
      "description": "Closed classification only. It identifies no underlying private payload, physical cause, absent child, Native effect settlement or permission.",
      "enum": [
        "unavailable"
      ],
      "type": "string"
    },
    "RetainedFrontierOutcome": {
      "description": "A terminal failure after the real projection response cannot become a second RPC response or be silently mistaken for an applied UI tail.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "ready"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "title": "ReadyRetainedFrontierOutcome",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "$ref": "#/definitions/RetainedFrontierFailure"
            },
            "state": {
              "enum": [
                "failed"
              ],
              "type": "string"
            }
          },
          "required": [
            "reason",
            "state"
          ],
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "frontier": {
      "type": "string"
    },
    "outcome": {
      "$ref": "#/definitions/RetainedFrontierOutcome"
    },
    "runtime": {
      "type": "string"
    },
    "snapshot": {
      "type": "string"
    },
    "version": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "frontier",
    "outcome",
    "runtime",
    "snapshot",
    "version"
  ],
  "title": "RetainedConfiguredNotification",
  "type": "object"
}