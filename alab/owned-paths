# alab/owned-paths — paths outside alab/ that ALab owns although upstream may also ship them.
#
# Same syntax as alab/removed-paths. When an upstream merge conflicts in one of these,
# alab/sync.sh keeps ALab's side and saves upstream's version as alab/upstream/<path>, so
# whoever maintains the ALab file can carry over what matters from it.

